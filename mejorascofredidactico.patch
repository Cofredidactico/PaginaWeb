+// ── Datos estructurados de producto (JSON-LD para Google) ──
+// Genera un ItemList con cada material activo → Google puede mostrar precio y disponibilidad.
+function generarSchemaProductos(){
+  const BASE = 'https://cofredidactico.github.io/PaginaWeb/';
+  const prods = (_data.productos || []).filter(p => p.activo);
+  if (!prods.length) return;
+  const items = prods.map((p, i) => {
+    const imgRel = normImg(p.imagen);
+    const prod = {
+      "@type": "Product",
+      "name": p.nombre,
+      "description": (p.descripcion || '').slice(0, 300),
+      "sku": p.id || undefined,
+      "image": imgRel ? BASE + imgRel : undefined,
+      "brand": { "@type": "Brand", "name": "Cofre Didáctico" },
+      "url": BASE + '#/producto/' + (p.id || '')
+    };
+    const precio = p.acceso === 'gratis' ? 0 : (p.precio || 0);
+    prod.offers = {
+      "@type": "Offer",
+      "price": precio,
+      "priceCurrency": "ARS",
+      "availability": "https://schema.org/InStock",
+      "url": p.link || (BASE + '#/producto/' + (p.id || ''))
+    };
+    return { "@type": "ListItem", "position": i + 1, "item": prod };
+  });
+  const schema = { "@context": "https://schema.org", "@type": "ItemList", "itemListElement": items };
+  const el = document.createElement('script');
+  el.type = 'application/ld+json';
+  el.id = 'schema-productos';
+  el.textContent = JSON.stringify(schema);
+  document.head.appendChild(el);
+}
